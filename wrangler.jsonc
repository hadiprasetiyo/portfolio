{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// kunci uji resmi Turnstile (selalu lolos); production wajib diganti kunci asli sebelum launch
	"vars": {
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio",
			"migrations_dir": "migrations",
			"database_id": "ccb89c21-62fd-49a3-a582-e7cc9b41dd91"
		}
	],
	"kv_namespaces": [
		{
			"binding": "MEDIA",
			"id": "a5a7991710574d2d99951ceda3c6f99a"
		}
	],
	// build production membaca D1 asli; tanpa CLOUDFLARE_ENV semua binding tetap lokal
	"env": {
		"production": {
			"name": "portfolio",
			"vars": {
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "portfolio",
					"migrations_dir": "migrations",
					"database_id": "ccb89c21-62fd-49a3-a582-e7cc9b41dd91",
					"remote": true
				}
			],
			"kv_namespaces": [
				{
					"binding": "MEDIA",
					"id": "a5a7991710574d2d99951ceda3c6f99a"
				}
			]
		}
	}
}
---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  href?: string;
  loading?: boolean;
} & HTMLAttributes<'button'>;

const { variant = 'primary', href, loading = false, class: className, ...rest } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} aria-busy={loading ? 'true' : undefined} disabled={loading || rest.disabled} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-6);
    border: 1px solid var(--line);
    border-radius: 0;
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease),
      border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  /* emas berisi teks gelap; teks krem di atas emas kontrasnya terlalu rendah */
  .button--primary {
    background: var(--gold);
    color: var(--bg);
    border-color: var(--gold);
  }

  .button--secondary {
    background: transparent;
    color: var(--fg);
    border-color: rgba(217, 194, 154, 0.45);
  }

  @media (hover: hover) {
    .button--primary:hover {
      background: var(--sun);
      border-color: var(--sun);
      color: var(--bg);
    }

    .button--secondary:hover {
      border-color: var(--gold);
      color: var(--gold);
    }
  }

  .button:active {
    transform: scale(0.97);
  }

  .button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .button[aria-busy='true'] {
    opacity: 1;
    cursor: progress;
  }

  .button[aria-busy='true']::before {
    content: '';
    width: 0.875rem;
    height: 0.875rem;
    border: 1px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
</style>

  .mail[data-sealed='opening'] .mail__cover-clasp {
    rotate: 90deg;
  }

  /* tutup pindah ke belakang surat begitu melewati tegak, supaya surat naik di depannya */
  .mail[data-sealed='opening'] .mail__cover-flap {
    z-index: 0;
    rotate: x 180deg;
    opacity: 0;

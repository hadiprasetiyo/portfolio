  }

  /* terbang: terangkat sedikit, lalu melesat mengecil; kertasnya memudar dan tinggal cahaya gesper sebagai bintang */
  .mail[data-sealed='flying'] .mail__cover-env {
    animation: mail-fly 1.5s both;

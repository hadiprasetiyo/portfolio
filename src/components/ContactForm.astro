  /* surat dan latar sudah tertutup kantong, jadi langsung disembunyikan supaya tidak tembus saat amplop memudar */
  .mail[data-sealed='flying'] .mail__cover-env::before,
  .mail[data-sealed='flying'] .mail__cover-letter {
    opacity: 0;

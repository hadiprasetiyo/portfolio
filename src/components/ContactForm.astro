  }

  .mail[data-sealed='opening'] .mail__cover-letter {
    translate: 0 -48%;
    transition: translate 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.7s;
  }

  .mail[data-sealed='opening'] .mail__cover-env::before,
  .mail[data-sealed='opening'] .mail__cover-pocket {
    opacity: 0;
    transition-delay: 1.15s;
  }

  /* ---------- kirim: kebalikan dari buka, lalu amplop terbang dan menjadi bintang ---------- */
  /* posisi awal menutup: amplop terbuka dengan surat setengah keluar, muncul tanpa transisi */
  .mail[data-sealed='closing'] .mail__cover-flap {
    z-index: 0;
    rotate: x 180deg;
  }

  .mail[data-sealed='closing'] .mail__cover-letter {
    translate: 0 -48%;
  }

  .mail[data-sealed='closing'] .mail__cover-clasp {
    rotate: 90deg;
  }

  /* surat turun masuk, tutup berayun menutup dan pindah ke depan setelah tegak, gesper diputar mengunci */
  .mail[data-sealed='sealing'] .mail__cover-letter {
    transition: translate 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .mail[data-sealed='sealing'] .mail__cover-flap {
    transition: rotate 0.65s cubic-bezier(0.45, 0, 0.2, 1) 0.4s, z-index 0s 0.72s;

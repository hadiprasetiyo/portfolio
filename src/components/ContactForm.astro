---
import { env } from 'cloudflare:workers';
import { getDictionary, type Locale } from '../i18n';
import { HONEYPOT_FIELD } from '../lib/contact';
import Button from './Button.astro';

type Props = { lang: Locale };
const { lang } = Astro.props;
const dictionary = getDictionary(lang).contact;
const messages = {
  sending: dictionary.sending,
  sent: dictionary.sent,
  failed: dictionary.failed,
  invalid: dictionary.invalid,
  errors: dictionary.errors,
};
---

<form class="contact-form" method="post" action="/api/contact" data-contact-form data-messages={JSON.stringify(messages)} novalidate>
  <input type="hidden" name="locale" value={lang} />
  <div class="contact-form__row">
  <div class="field">
    <label for="contact-name"><span aria-hidden="true">I</span>{dictionary.name}</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="contact-name-error" />
    <p class="field__error" id="contact-name-error" hidden>{dictionary.errors.name}</p>
  </div>
  <div class="field">
    <label for="contact-email"><span aria-hidden="true">II</span>{dictionary.email}</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" />
    <p class="field__error" id="contact-email-error" hidden>{dictionary.errors.email}</p>
  </div>
  </div>
  <div class="field">
    <label for="contact-message"><span aria-hidden="true">III</span>{dictionary.message}</label>
    <textarea id="contact-message" name="message" rows="6" maxlength="2000" required aria-describedby="contact-message-error"></textarea>
    <p class="field__error" id="contact-message-error" hidden>{dictionary.errors.message}</p>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="contact-form__footer">
    <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language={lang} data-theme="dark"></div>
    <Button type="submit" variant="secondary" class="contact-form__send">{dictionary.send}</Button>
  </div>
  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script is:inline>
  {
    const form = document.querySelector('[data-contact-form]');
    const messages = JSON.parse(form.dataset.messages);
    const button = form.querySelector('[type="submit"]');
    const status = form.querySelector('.contact-form__status');
    const label = button.textContent;

    // script Turnstile pihak ketiga baru dimuat saat form disentuh, supaya tidak membebani muat halaman
    form.addEventListener(
      'focusin',
      () => {
        // widget normal selebar 300px tidak muat di lembar surat pada HP sempit
        if (form.querySelector('.contact-form__footer').clientWidth < 300) form.querySelector('.cf-turnstile').dataset.size = 'compact';
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        script.async = true;
        document.head.append(script);
      },
      { once: true },
    );

    const showErrors = (fields) => {
      for (const field of ['name', 'email', 'message']) {
        const invalid = fields.includes(field);
        form.elements[field].setAttribute('aria-invalid', String(invalid));
        form.querySelector(`#contact-${field}-error`).hidden = !invalid;
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showErrors([]);
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = messages.sending;
      status.textContent = '';
      status.dataset.state = '';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (response.ok) {
          form.reset();
          status.textContent = messages.sent;
          status.dataset.state = 'success';
        } else {
          const fields = result.fields ?? [];
          showErrors(fields);
          status.textContent = fields.includes('captcha') ? messages.errors.captcha : messages.invalid;
          status.dataset.state = 'error';
          form.querySelector('[aria-invalid="true"]')?.focus();
        }
      } catch {
        status.textContent = messages.failed;
        status.dataset.state = 'error';
      } finally {
        window.turnstile?.reset();
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: 40px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 40px 32px;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  label {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--muted);
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.5s var(--ease);
  }

  label span {
    color: var(--gold);
  }

  .field:focus-within label {
    color: var(--fg);
  }

  input,
  textarea {
    width: 100%;
    padding: 6px 0 12px;
    border: 0;
    border-bottom: 1px solid rgba(217, 194, 154, 0.28);
    border-radius: 0;
    /* garis tulis emas yang memanjang dari tengah saat kolom diisi */
    background: linear-gradient(var(--gold), var(--gold)) 50% 100% / 0 1px no-repeat;
    background-origin: border-box;
    color: var(--fg);
    font: 400 22px/1.35 var(--font-serif);
    caret-color: var(--gold);
    transition: border-color 0.5s var(--ease), background-size 0.7s var(--ease);
  }

  /* garis emas yang memanjang sudah jadi penanda fokus */
  input:focus,
  textarea:focus {
    outline: none;
    background-size: 100% 1px;
  }

  /* isian otomatis browser tidak boleh memberi latar biru atau kuning di lembar gelap */
  input:-webkit-autofill {
    -webkit-text-fill-color: var(--fg);
    transition: background-color 600000s;
  }

  textarea {
    min-height: 8.5rem;
    resize: vertical;
    font-size: 20px;
    line-height: 1.5;
  }

  input:hover,
  textarea:hover {
    border-color: rgba(217, 194, 154, 0.5);
  }

  [aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .field__error {
    font-size: var(--text-sm);
    color: var(--color-danger);
  }

  /* disembunyikan dari manusia dengan cara yang tetap diisi bot (bukan display:none) */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ruang untuk widget Turnstile (300x65) disiapkan sejak awal supaya tidak ada layout shift saat muncul */
  .cf-turnstile {
    min-height: 65px;
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 24px;
  }

  .contact-form :global(.contact-form__send) {
    min-height: 3rem;
    padding-inline: 32px;
    border-color: rgba(217, 194, 154, 0.6);
    color: var(--gold);
  }

  @media (hover: hover) {
    .contact-form :global(.contact-form__send:hover) {
      border-color: var(--sun);
      background: rgba(217, 194, 154, 0.08);
      color: var(--sun);
    }
  }

  .contact-form__status {
    margin-top: -16px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status[data-state='success'] {
    color: var(--gold);
  }

  .contact-form__status[data-state='error'] {
    color: var(--color-danger);
  }
</style>

---
import { env } from 'cloudflare:workers';
import { getDictionary, type Locale } from '../i18n';
import { HONEYPOT_FIELD } from '../lib/contact';
import Button from './Button.astro';

type Props = { lang: Locale };
const { lang } = Astro.props;
const dictionary = getDictionary(lang).contact;
const messages = {
  sending: dictionary.sending,
  sent: dictionary.sent,
  failed: dictionary.failed,
  invalid: dictionary.invalid,
  errors: dictionary.errors,
};
---

<form class="contact-form" method="post" action="/api/contact" data-contact-form data-messages={JSON.stringify(messages)} novalidate>
  <input type="hidden" name="locale" value={lang} />
  <div class="field">
    <label for="contact-name">{dictionary.name}</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="contact-name-error" />
    <p class="field__error" id="contact-name-error" hidden>{dictionary.errors.name}</p>
  </div>
  <div class="field">
    <label for="contact-email">{dictionary.email}</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" />
    <p class="field__error" id="contact-email-error" hidden>{dictionary.errors.email}</p>
  </div>
  <div class="field">
    <label for="contact-message">{dictionary.message}</label>
    <textarea id="contact-message" name="message" rows="6" maxlength="2000" required aria-describedby="contact-message-error"></textarea>
    <p class="field__error" id="contact-message-error" hidden>{dictionary.errors.message}</p>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language={lang}></div>
  <div class="contact-form__footer">
    <Button type="submit">{dictionary.send}</Button>
    <p class="contact-form__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script is:inline>
  {
    const form = document.querySelector('[data-contact-form]');
    const messages = JSON.parse(form.dataset.messages);
    const button = form.querySelector('[type="submit"]');
    const status = form.querySelector('.contact-form__status');
    const label = button.textContent;

    // script Turnstile pihak ketiga baru dimuat saat form disentuh, supaya tidak membebani muat halaman
    form.addEventListener(
      'focusin',
      () => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        script.async = true;
        document.head.append(script);
      },
      { once: true },
    );

    const showErrors = (fields) => {
      for (const field of ['name', 'email', 'message']) {
        const invalid = fields.includes(field);
        form.elements[field].setAttribute('aria-invalid', String(invalid));
        form.querySelector(`#contact-${field}-error`).hidden = !invalid;
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showErrors([]);
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = messages.sending;
      status.textContent = '';
      status.dataset.state = '';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (response.ok) {
          form.reset();
          status.textContent = messages.sent;
          status.dataset.state = 'success';
        } else {
          const fields = result.fields ?? [];
          showErrors(fields);
          status.textContent = fields.includes('captcha') ? messages.errors.captcha : messages.invalid;
          status.dataset.state = 'error';
          form.querySelector('[aria-invalid="true"]')?.focus();
        }
      } catch {
        status.textContent = messages.failed;
        status.dataset.state = 'error';
      } finally {
        window.turnstile?.reset();
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-6);
    max-width: 36rem;
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid color-mix(in oklab, var(--color-text) 30%, var(--color-bg));
    border-radius: var(--radius-sm);
    transition: border-color var(--duration) var(--ease-out);
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: color-mix(in oklab, var(--color-text) 55%, var(--color-bg));
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent);
  }

  [aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .field__error {
    font-size: var(--text-sm);
    color: var(--color-danger);
  }

  /* disembunyikan dari manusia dengan cara yang tetap diisi bot (bukan display:none) */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ruang untuk widget Turnstile (300x65) disiapkan sejak awal supaya tidak ada layout shift saat muncul */
  .cf-turnstile {
    min-height: 65px;
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .contact-form__status {
    font-size: var(--text-sm);
  }

  .contact-form__status[data-state='error'] {
    color: var(--color-danger);
  }
</style>

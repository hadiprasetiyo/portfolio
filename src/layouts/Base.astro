---
import { Font } from 'astro:assets';
import { getDictionary, LOCALES, type Locale } from '../i18n';
import { getProfile } from '../lib/db';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  lang: Locale;
  // path tanpa awalan bahasa, dipakai switcher EN · ID dan nav
  path: string;
  // halaman utama menaruh hero di bawah nav yang transparan, halaman lain diberi jarak dari nav
  fullBleed?: boolean;
};

const { title, description, lang, path, fullBleed = false } = Astro.props;
const profile = await getProfile();
const dictionary = getDictionary(lang);

const languageNames: Record<Locale, string> = { en: 'English', id: 'Bahasa Indonesia' };
const home = `/${lang}/`;
const navigation = [
  { href: `${home}#projects`, label: dictionary.nav.projects },
  { href: `${home}#skills`, label: dictionary.nav.skills },
  { href: `${home}#experience`, label: dictionary.nav.experience },
  { href: `${home}#contact`, label: dictionary.nav.contact },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07070A" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-script" preload />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <canvas class="sky" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">{dictionary.skipToContent}</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href={home} aria-label={`hadiiyok, ${dictionary.backToTop}`}>hadiiyok</a>
        <nav class="site-nav" aria-label={dictionary.mainNavigation}>
          <ul role="list">
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li><a href={`/${lang}/cv`} aria-current={path === '/cv' ? 'page' : undefined}>{dictionary.nav.cv}</a></li>
          </ul>
        </nav>
        <nav class="language-switcher" aria-label={dictionary.languageSwitcher}>
          {
            LOCALES.map((code, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={`/${code}${path}`}
                  hreflang={code}
                  lang={code}
                  aria-label={languageNames[code]}
                  aria-current={code === lang ? 'page' : undefined}
                >
                  {code.toUpperCase()}
                </a>
              </>
            ))
          }
        </nav>
        <button class="sound" type="button" aria-pressed="false" aria-label={dictionary.sound.play} data-play={dictionary.sound.play} data-pause={dictionary.sound.pause}
          ><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sound__label">{dictionary.sound.label}</span></button
        >
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={{ 'main--padded': !fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="label">© {new Date().getFullYear()} {profile?.full_name} · {dictionary.footer.builtWith}</p>
      </div>
    </footer>
    <script>
      import { startCursor } from '../scripts/cursor';
      import '../scripts/smooth-scroll';
      import { startSky } from '../scripts/sky';
      import { startSound } from '../scripts/sound.js';

      startSky(document.querySelector<HTMLCanvasElement>('.sky')!);
      startCursor();
      startSound();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .site-header {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    right: 0;
    left: 0;
    z-index: var(--z-sticky);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 76px;
  }

  /* font script hanya dipakai sebagai aksen: logo dan nama di hero */
  .logo {
    padding: 0.1em 0.2em 0.1em 0;
    color: var(--fg);
    font: 400 40px/0.8 var(--font-script);
    text-decoration: none;
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: 26px;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-height: 2.75rem;
    font-size: 13.5px;
    font-weight: 400;
    text-decoration: none;
  }

  /* garis bawah tumbuh dari kiri saat hover */
  .site-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 10px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--fg);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .language-switcher a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current='page'] {
    color: var(--fg);
  }

  /* di layar sempit nav anchor disembunyikan; halaman utama cukup di-scroll */
  @media (max-width: 56rem) {
    .site-nav {
      display: none;
    }

    .language-switcher {
      margin-left: auto;
    }
  }

  main {
    position: relative;
  }

  .main--padded {
    padding-block: calc(76px + var(--space-16)) var(--space-24);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    position: relative;
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
</style>

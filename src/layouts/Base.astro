---
import { Font } from 'astro:assets';
import { getDictionary, LOCALES, type Locale } from '../i18n';
import { getProfile } from '../lib/db';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  lang: Locale;
  // path tanpa awalan bahasa, dipakai switcher EN · ID dan nav
  path: string;
  // halaman utama menaruh hero di bawah nav yang transparan, halaman lain diberi jarak dari nav
  fullBleed?: boolean;
};

const { title, description, lang, path, fullBleed = false } = Astro.props;
const profile = await getProfile();
const dictionary = getDictionary(lang);

const languageNames: Record<Locale, string> = { en: 'English', id: 'Bahasa Indonesia' };
const home = `/${lang}/`;
// nomor sama dengan nomor bab di halaman utama
const chapters = [
  { id: 'about', label: dictionary.nav.about, detail: dictionary.nav.details.about, number: '01', roman: 'I' },
  { id: 'projects', label: dictionary.nav.projects, detail: dictionary.nav.details.projects, number: '02', roman: 'II' },
  { id: 'skills', label: dictionary.nav.skills, detail: dictionary.nav.details.skills, number: '03', roman: 'III' },
  { id: 'experience', label: dictionary.nav.experience, detail: dictionary.nav.details.experience, number: '04', roman: 'IV' },
  { id: 'contact', label: dictionary.nav.contact, detail: dictionary.nav.details.contact, number: '05', roman: 'V' },
];

// pelat astrolabe digambar saat build: bab berjarak sama di tepi, mulai dari puncak seperti angka jam
const step = 360 / chapters.length;
const polar = (center: number, radius: number, degrees: number) => {
  const angle = (degrees * Math.PI) / 180;
  return [center + radius * Math.sin(angle), center - radius * Math.cos(angle)].map((value) => Number(value.toFixed(2)));
};
const scaleTicks = Array.from({ length: 72 }, (_, k) => {
  const major = (k * 5) % 30 === 0;
  const [x1, y1] = polar(240, major ? 184 : 192, k * 5);
  const [x2, y2] = polar(240, 200, k * 5);
  return { x1, y1, x2, y2, major };
});
const platePoints = chapters.map((_, i) => {
  const [x, y] = polar(240, 200, i * step);
  const [left, top] = polar(50, 49.2, i * step);
  return { angle: i * step, x, y, left, top };
});
const dialTicks = chapters.map((_, i) => {
  const [x1, y1] = polar(19, 13.5, i * step);
  const [x2, y2] = polar(19, 17.5, i * step);
  return { x1, y1, x2, y2 };
});
const circleLength = (radius: number) => Math.ceil(2 * Math.PI * radius);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07070A" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-script" preload />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <canvas class="sky" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">{dictionary.skipToContent}</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href={home} aria-label={`hadiiyok, ${dictionary.backToTop}`}>hadiiyok</a>
        <nav class="language-switcher" aria-label={dictionary.languageSwitcher}>
          {
            LOCALES.map((code, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={`/${code}${path}`}
                  hreflang={code}
                  lang={code}
                  aria-label={languageNames[code]}
                  aria-current={code === lang ? 'page' : undefined}
                >
                  {code.toUpperCase()}
                </a>
              </>
            ))
          }
        </nav>
        <button class="sound" type="button" aria-pressed="false" aria-label={dictionary.sound.play} data-play={dictionary.sound.play} data-pause={dictionary.sound.pause}
          ><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sound__label">{dictionary.sound.label}</span></button
        >
        <button class="dial-button" type="button" aria-expanded="false" aria-controls="site-index" aria-label={dictionary.nav.index} data-open={dictionary.nav.index} data-close={dictionary.nav.close}>
          <span class="dial-button__text" aria-hidden="true"><small></small><span>{dictionary.nav.index}</span></span>
          <svg class="dial" viewBox="0 0 38 38" aria-hidden="true">
            <circle cx="19" cy="19" r="17.5"></circle>
            {dialTicks.map((tick) => <line class="dial__tick" {...tick}></line>)}
            <g class="dial__needle"><line x1="19" y1="22" x2="19" y2="5"></line></g>
            <circle class="dial__pin" cx="19" cy="19" r="1.4"></circle>
          </svg>
        </button>
      </div>
    </header>
    <nav class="site-index" id="site-index" aria-label={dictionary.mainNavigation} inert>
      <div class="wrap site-index__inner">
        <div class="plate">
          {/* pelat astrolabe: skala derajat, lingkaran horizon dan tropika, jarum alidade yang membidik bab */}
          <svg viewBox="0 0 480 480" aria-hidden="true">
            <circle class="plate__ring plate__ring--strong plate__draw" cx="240" cy="240" r="200" style={`--length:${circleLength(200)}`}></circle>
            <circle class="plate__ring plate__draw" cx="240" cy="240" r="184" style={`--length:${circleLength(184)}`}></circle>
            <g class="plate__scale">{scaleTicks.map(({ major, ...tick }) => <line class:list={{ major }} {...tick}></line>)}</g>
            <circle class="plate__ring plate__draw" cx="240" cy="240" r="150" style={`--length:${circleLength(150)}`}></circle>
            <circle class="plate__ring plate__draw" cx="240" cy="262" r="112" style={`--length:${circleLength(112)}`}></circle>
            <circle class="plate__ring plate__draw" cx="240" cy="284" r="72" style={`--length:${circleLength(72)}`}></circle>
            <line class="plate__ring plate__draw" x1="40" y1="240" x2="440" y2="240" style="--length:400"></line>
            <line class="plate__ring plate__draw" x1="240" y1="40" x2="240" y2="440" style="--length:400"></line>
            {
              platePoints.map((point, i) => (
                <path
                  class="plate__marker"
                  data-chapter={i}
                  d={`M${point.x} ${point.y - 5} L${point.x + 3} ${point.y} L${point.x} ${point.y + 5} L${point.x - 3} ${point.y} Z`}
                  transform={`rotate(${point.angle} ${point.x} ${point.y})`}
                ></path>
              ))
            }
            <g class="plate__alidade">
              <line x1="240" y1="410" x2="240" y2="70"></line>
              <path class="plate__vane" d="M240 52 L245 70 L235 70 Z"></path>
              <circle class="plate__counter" cx="240" cy="404" r="6"></circle>
            </g>
            <circle class="plate__pin" cx="240" cy="240" r="5"></circle>
          </svg>
          {/* nama di tepi hanya untuk mouse; pembaca layar dan keyboard memakai daftar di sebelahnya */}
          {
            chapters.map((chapter, i) => (
              <a class="plate__rim" href={`${home}#${chapter.id}`} data-chapter={i} style={`left:${platePoints[i].left}%;top:${platePoints[i].top}%`} aria-hidden="true" tabindex="-1">
                <span>{chapter.roman}</span>
                <strong>{chapter.label}</strong>
              </a>
            ))
          }
          <div class="plate__readout" aria-hidden="true"><span></span><strong></strong><small></small></div>
        </div>
        <div class="ledger">
          <ol role="list">
            {
              chapters.map((chapter, i) => (
                <li>
                  <a href={`${home}#${chapter.id}`} data-chapter={i} data-number={chapter.number} data-roman={chapter.roman} data-label={chapter.label} data-detail={chapter.detail}>
                    <span>{chapter.roman}</span>
                    <strong>{chapter.label}</strong>
                    <small>No. {chapter.number}</small>
                  </a>
                </li>
              ))
            }
          </ol>
          <a class="ledger__cv" href={`/${lang}/cv`} aria-current={path === '/cv' ? 'page' : undefined}>{dictionary.nav.cv} ↗</a>
        </div>
      </div>
    </nav>
    <main id="main" tabindex="-1" class:list={{ 'main--padded': !fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="label">© {new Date().getFullYear()} {profile?.full_name} · {dictionary.footer.builtWith}</p>
      </div>
    </footer>
    <script>
      import { startCursor } from '../scripts/cursor';
      import { startNavigation } from '../scripts/navigation';
      import '../scripts/smooth-scroll';
      import { startSky } from '../scripts/sky';
      import { startSound } from '../scripts/sound.js';

      startSky(document.querySelector<HTMLCanvasElement>('.sky')!);
      startCursor();
      startSound();
      startNavigation();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .site-header {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    right: 0;
    left: 0;
    z-index: var(--z-sticky);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 76px;
  }

  /* font script hanya dipakai sebagai aksen: logo dan nama di hero */
  .logo {
    padding: 0.1em 0.2em 0.1em 0;
    color: var(--fg);
    font: 400 40px/0.8 var(--font-script);
    text-decoration: none;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--muted);
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .language-switcher a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current='page'] {
    color: var(--fg);
  }

  /* dial: jarumnya maju mengikuti posisi baca, lima tanda di lingkarannya adalah lima bab */
  .dial-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }

  .dial-button__text {
    display: grid;
    justify-items: end;
    gap: 3px;
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dial-button__text small {
    color: var(--gold);
    font: inherit;
  }

  .dial-button__text small:empty {
    display: none;
  }

  .dial {
    width: 38px;
    height: 38px;
    overflow: visible;
  }

  .dial circle {
    fill: none;
    stroke: rgba(217, 194, 154, 0.38);
    stroke-width: 0.8;
  }

  .dial__tick {
    stroke: var(--faint);
    stroke-width: 1.2;
    transition: stroke 0.6s var(--ease);
  }

  .dial__tick.is-active {
    stroke: var(--sun);
    filter: drop-shadow(0 0 2px rgba(255, 236, 200, 0.9));
  }

  .dial__needle {
    transform-origin: 19px 19px;
    transition: transform 0.8s var(--ease);
  }

  .dial__needle line {
    stroke: var(--sun);
    stroke-width: 0.9;
  }

  .dial .dial__pin {
    fill: var(--sun);
    stroke: none;
  }

  /* indeks layar penuh, terbuka melingkar dari dial; di bawah header supaya dial tetap jadi tombol tutup */
  .site-index {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-sticky) - 1);
    display: grid;
    align-items: center;
    padding-block: calc(84px + env(safe-area-inset-top, 0px)) 32px;
    overflow-y: auto;
    background: var(--bg);
    clip-path: circle(0 at var(--ox, 100%) var(--oy, 0));
    visibility: hidden;
    transition: clip-path 1.1s var(--ease), visibility 0s linear 1.1s;
  }

  .site-index.is-open {
    clip-path: circle(150% at var(--ox, 100%) var(--oy, 0));
    visibility: visible;
    transition: clip-path 1.1s var(--ease), visibility 0s;
  }

  .site-index__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: 56px;
  }

  .plate {
    position: relative;
    justify-self: center;
    width: min(100%, 560px, 68vh);
    aspect-ratio: 1;
  }

  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .plate__ring {
    fill: none;
    stroke: rgba(217, 194, 154, 0.2);
    stroke-width: 0.7;
  }

  .plate__ring--strong {
    stroke: rgba(217, 194, 154, 0.38);
  }

  .plate__scale line {
    stroke: rgba(217, 194, 154, 0.2);
    stroke-width: 0.7;
  }

  .plate__scale line.major {
    stroke: rgba(217, 194, 154, 0.38);
  }

  /* garis pelat tergambar sekali saat indeks dibuka */
  .plate__draw {
    stroke-dasharray: var(--length);
    stroke-dashoffset: var(--length);
    transition: stroke-dashoffset 1.6s var(--ease) 0.25s;
  }

  .site-index.is-open .plate__draw {
    stroke-dashoffset: 0;
  }

  .plate__marker {
    fill: var(--faint);
    transition: fill 0.5s var(--ease);
  }

  .plate__marker.is-current {
    fill: var(--gold);
  }

  .plate__marker.is-aim {
    fill: var(--sun);
  }

  .plate__alidade {
    transform-origin: 240px 240px;
    transition: transform 1.1s var(--ease);
  }

  .plate__alidade line {
    stroke: var(--sun);
    stroke-width: 0.8;
  }

  .plate__vane {
    fill: var(--sun);
  }

  .plate__counter {
    fill: none;
    stroke: rgba(217, 194, 154, 0.38);
    stroke-width: 0.8;
  }

  .plate__pin {
    fill: var(--bg);
    stroke: var(--gold);
    stroke-width: 0.8;
  }

  /* bab di tepi pelat, seperti angka jam */
  .plate__rim {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 6px 8px;
    color: var(--muted);
    text-decoration: none;
    transform: translate(-50%, -50%);
    transition: color 0.5s var(--ease);
  }

  .plate__rim span {
    color: var(--faint);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    transition: color 0.5s var(--ease);
  }

  .plate__rim strong {
    color: inherit;
    font: 400 20px/1 var(--font-serif);
    white-space: nowrap;
  }

  .plate__rim:hover,
  .plate__rim.is-aim {
    color: var(--fg);
  }

  .plate__rim.is-current span {
    color: var(--gold);
  }

  .plate__readout {
    position: absolute;
    inset: 31%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    text-align: center;
    /* jarum alidade melintas di belakang bacaan; bayangan selatar langit menjaga hurufnya tetap terbaca */
    text-shadow: 0 0 14px var(--bg), 0 0 6px var(--bg), 0 0 2px var(--bg);
    pointer-events: none;
  }

  .plate__readout span {
    color: var(--gold);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .plate__readout strong {
    font: 400 clamp(26px, 3.2vw, 44px)/1 var(--font-serif);
  }

  .plate__readout small {
    color: var(--muted);
    font: 400 10px/1.5 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .plate__readout > * {
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .plate__readout.is-swapping > * {
    opacity: 0;
    transform: translateY(6px);
  }

  /* daftar bab yang sama: dibaca cepat, dipakai keyboard, dan disentuh di HP */
  .ledger {
    display: grid;
    gap: 22px;
  }

  .ledger ol {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .ledger ol a {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }

  .ledger span,
  .ledger small {
    color: var(--faint);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.5s var(--ease);
  }

  .ledger strong {
    color: inherit;
    font: 400 clamp(24px, 2.4vw, 32px)/1.1 var(--font-serif);
  }

  .ledger ol a:hover,
  .ledger ol a.is-aim {
    color: var(--fg);
  }

  .ledger ol a.is-current span {
    color: var(--gold);
  }

  .ledger__cv {
    justify-self: start;
    color: var(--fg);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* layar sempit: pelat mengecil di atas tanpa nama di tepi, daftar bab di bawahnya */
  @media (max-width: 56rem) {
    .site-index {
      align-items: start;
    }

    .site-index__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .plate {
      width: min(100%, 300px);
    }

    .plate__rim strong,
    .plate__readout small {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      gap: 16px;
    }

    .dial-button__text,
    .sound__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-index,
    .site-index.is-open,
    .plate__draw,
    .plate__alidade,
    .dial__needle {
      transition: none;
    }
  }

  main {
    position: relative;
  }

  .main--padded {
    padding-block: calc(76px + var(--space-16)) var(--space-24);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    position: relative;
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
</style>

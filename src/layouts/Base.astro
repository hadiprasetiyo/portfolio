---
import { Font } from 'astro:assets';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { getDictionary, LOCALES, type Locale } from '../i18n';
import { getProfile, getSettings, getThemes } from '../lib/db';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  lang: Locale;
  // path tanpa awalan bahasa, dipakai switcher EN · ID dan nav
  path: string;
};

const { title, description, lang, path } = Astro.props;
const [themes, settings, profile] = await Promise.all([getThemes(), getSettings(), getProfile()]);
const dictionary = getDictionary(lang);

// warna aman di-inline: kolomnya dijaga CHECK hex di database
const themeCss = themes
  .map(
    (theme) =>
      `[data-theme="${theme.id}"]{--color-bg:${theme.color_bg};--color-text:${theme.color_text};--color-accent:${theme.color_accent};--color-highlight:${theme.color_highlight}}`,
  )
  .join('');
const languageNames: Record<Locale, string> = { en: 'English', id: 'Bahasa Indonesia' };
const home = `/${lang}/`;
const navigation = [
  { href: `${home}#about`, label: dictionary.nav.about },
  { href: `${home}#projects`, label: dictionary.nav.projects },
  { href: `${home}#experience`, label: dictionary.nav.experience },
  { href: `${home}#contact`, label: dictionary.nav.contact },
];
---

<html lang={lang} data-theme={settings.theme_id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-sans" preload />
    <style set:html={themeCss}></style>
    <script is:inline define:vars={{ themeIds: themes.map((theme) => String(theme.id)) }}>
      // dijalankan sebelum paint supaya tema pilihan pengunjung tidak berkedip
      try {
        const saved = localStorage.getItem('theme');
        if (themeIds.includes(saved)) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{dictionary.skipToContent}</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={home}>{profile?.full_name ?? 'Portfolio'}</a>
        <nav class="site-nav" aria-label={dictionary.mainNavigation}>
          <ul role="list">
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li><a href={`/${lang}/cv`} aria-current={path === '/cv' ? 'page' : undefined}>{dictionary.nav.cv}</a></li>
          </ul>
        </nav>
        <div class="site-header__controls">
          <nav class="language-switcher" aria-label={dictionary.languageSwitcher}>
            {
              LOCALES.map((code, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <a
                    href={`/${code}${path}`}
                    hreflang={code}
                    lang={code}
                    aria-label={languageNames[code]}
                    aria-current={code === lang ? 'page' : undefined}
                  >
                    {code.toUpperCase()}
                  </a>
                </>
              ))
            }
          </nav>
          <ThemeSwitcher themes={themes} label={dictionary.themeSwitcher} />
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} {profile?.full_name}</p>
        <p>{dictionary.footer.builtWith}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4rem;
  }

  .brand {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-nav a,
  .language-switcher a {
    display: inline-grid;
    place-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .language-switcher a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: auto;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    color: var(--color-muted);
  }

  .language-switcher a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* di layar sempit nav anchor disembunyikan; halaman utama cukup di-scroll, CV tetap terjangkau dari hero */
  @media (max-width: 56rem) {
    .site-nav {
      display: none;
    }
  }

  main {
    padding-block: var(--space-16) var(--space-24);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
</style>

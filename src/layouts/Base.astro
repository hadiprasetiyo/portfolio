---
import { Font } from 'astro:assets';
import { getDictionary, LOCALES, type Locale } from '../i18n';
import { getProfile } from '../lib/db';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  lang: Locale;
  // path tanpa awalan bahasa, dipakai switcher EN · ID dan nav
  path: string;
  // halaman utama menaruh hero di bawah nav yang transparan, halaman lain diberi jarak dari nav
  fullBleed?: boolean;
};

const { title, description, lang, path, fullBleed = false } = Astro.props;
const profile = await getProfile();
const dictionary = getDictionary(lang);

const languageNames: Record<Locale, string> = { en: 'English', id: 'Bahasa Indonesia' };
const home = `/${lang}/`;
// nomor sama dengan nomor bab di halaman utama
const chapters = [
  { id: 'about', label: dictionary.nav.about, detail: dictionary.nav.details.about, number: '01', roman: 'I' },
  { id: 'projects', label: dictionary.nav.projects, detail: dictionary.nav.details.projects, number: '02', roman: 'II' },
  { id: 'skills', label: dictionary.nav.skills, detail: dictionary.nav.details.skills, number: '03', roman: 'III' },
  { id: 'experience', label: dictionary.nav.experience, detail: dictionary.nav.details.experience, number: '04', roman: 'IV' },
  { id: 'contact', label: dictionary.nav.contact, detail: dictionary.nav.details.contact, number: '05', roman: 'V' },
];

// pelat astrolabe digambar saat build: bab berjarak sama di tepi, mulai dari puncak seperti angka jam
const step = 360 / chapters.length;
const polar = (center: number, radius: number, degrees: number) => {
  const angle = (degrees * Math.PI) / 180;
  return [center + radius * Math.sin(angle), center - radius * Math.cos(angle)].map((value) => Number(value.toFixed(2)));
};
// skala tiap 1° seperti limb astrolabe asli; panjang garis bertingkat 1°, 5°, 10°, 30°
const scaleTicks = Array.from({ length: 360 }, (_, degree) => {
  const tier = degree % 30 === 0 ? 'major' : degree % 10 === 0 ? 'mid' : degree % 5 === 0 ? 'five' : 'one';
  const inner = { major: 182, mid: 189, five: 192.5, one: 195.5 }[tier];
  const [x1, y1] = polar(240, inner, degree);
  const [x2, y2] = polar(240, 200, degree);
  return { x1, y1, x2, y2, tier };
});
const platePoints = chapters.map((_, i) => {
  const [x, y] = polar(240, 200, i * step);
  const [left, top] = polar(50, 49.2, i * step);
  return { angle: i * step, x, y, left, top };
});
const degreeLabels = Array.from({ length: 12 }, (_, k) => {
  const [x, y] = polar(240, 170, k * 30);
  return { x, y: y + 2.5, text: `${String(k * 30).padStart(3, '0')}°` };
});
const dialTicks = chapters.map((_, i) => {
  const [x1, y1] = polar(21, 15.5, i * step);
  const [x2, y2] = polar(21, 20, i * step);
  return { x1, y1, x2, y2 };
});
const circleLength = (radius: number) => Math.ceil(2 * Math.PI * radius);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07070A" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-script" preload />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <canvas class="sky" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">{dictionary.skipToContent}</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href={home} aria-label={`hadiiyok, ${dictionary.backToTop}`}>hadiiyok</a>
        <nav class="language-switcher" aria-label={dictionary.languageSwitcher}>
          {
            LOCALES.map((code, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={`/${code}${path}`}
                  hreflang={code}
                  lang={code}
                  aria-label={languageNames[code]}
                  aria-current={code === lang ? 'page' : undefined}
                >
                  {code.toUpperCase()}
                </a>
              </>
            ))
          }
        </nav>
        <button class="sound" type="button" aria-pressed="false" aria-label={dictionary.sound.play} data-play={dictionary.sound.play} data-pause={dictionary.sound.pause}
          ><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sound__label">{dictionary.sound.label}</span></button
        >
        <button class="dial-button" type="button" aria-expanded="false" aria-controls="site-index" aria-label={dictionary.nav.index} data-open={dictionary.nav.index} data-close={dictionary.nav.close}>
          <span class="dial-button__text" aria-hidden="true"><small></small><span>{dictionary.nav.index}</span></span>
          {/* dial kecil meniru pelat indeks: dua cincin, lima tanda bab, jarum bersirip dan berpemberat */}
          <svg class="dial" viewBox="0 0 42 42" aria-hidden="true">
            <circle class="dial__ring" cx="21" cy="21" r="20"></circle>
            <circle class="dial__inner" cx="21" cy="21" r="15.5"></circle>
            {dialTicks.map((tick) => <line class="dial__tick" {...tick}></line>)}
            <g class="dial__needle">
              <line x1="21" y1="25" x2="21" y2="8"></line>
              <path d="M21 4.5 L23 8.5 L19 8.5 Z"></path>
              <circle class="dial__counter" cx="21" cy="26.6" r="1.6"></circle>
            </g>
            <circle class="dial__pin" cx="21" cy="21" r="1.7"></circle>
          </svg>
        </button>
      </div>
    </header>
    <nav class="site-index" id="site-index" aria-label={dictionary.mainNavigation} inert>
      <div class="wrap site-index__inner">
        <div class="plate">
          {/* pelat astrolabe: skala derajat, lingkaran tropika, jarum alidade yang membidik bab */}
          <svg viewBox="0 0 480 480" aria-hidden="true">
            <defs>
              {/* kilau logam: terang di kiri atas seperti tertimpa lampu, redup di kanan bawah */}
              <linearGradient id="plate-metal" gradientUnits="userSpaceOnUse" x1="60" y1="40" x2="420" y2="440">
                <stop offset="0" stop-color="#fff4de"></stop>
                <stop offset="0.3" stop-color="#d9c29a"></stop>
                <stop offset="0.55" stop-color="#7d6a4b"></stop>
                <stop offset="0.78" stop-color="#cdb68d"></stop>
                <stop offset="1" stop-color="#6b5a3f"></stop>
              </linearGradient>
              {/* bilah alidade seperti batang logam bulat: gelap di tepi, terang di punggung */}
              <linearGradient id="alidade-metal" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#6b5a3f"></stop>
                <stop offset="0.42" stop-color="#fff4de"></stop>
                <stop offset="0.6" stop-color="#d9c29a"></stop>
                <stop offset="1" stop-color="#5e4f37"></stop>
              </linearGradient>
              <path id="plate-inscription" d="M240 122 A118 118 0 1 1 239.99 122"></path>
            </defs>
            <circle class="plate__ring plate__ring--hair" cx="240" cy="240" r="204"></circle>
            <circle class="plate__ring plate__ring--metal plate__draw" cx="240" cy="240" r="200" style={`--length:${circleLength(200)}`}></circle>
            <circle class="plate__ring plate__draw" cx="240" cy="240" r="182" style={`--length:${circleLength(182)}`}></circle>
            {/* skala derajat berputar masuk ke tempatnya saat indeks dibuka, seperti rete astrolabe */}
            <g class="plate__rete plate__scale">{scaleTicks.map(({ tier, ...tick }) => <line class={tier} {...tick}></line>)}</g>
            <circle class="plate__dots" cx="240" cy="240" r="150"></circle>
            <line class="plate__ring plate__draw" x1="90" y1="240" x2="390" y2="240" style="--length:300"></line>
            <line class="plate__ring plate__draw" x1="240" y1="90" x2="240" y2="390" style="--length:300"></line>
            {/* jendela bacaan menutup garis di tengah supaya nama bab tidak tercoret jarum */}
            <circle class="plate__window plate__draw" cx="240" cy="240" r="100" style={`--length:${circleLength(100)}`}></circle>
            <circle class="plate__ring plate__ring--metal plate__draw" cx="240" cy="240" r="96" style={`--length:${circleLength(96)}`}></circle>
            {/* inskripsi pembuat terukir melingkar, seperti tanda tangan di astrolabe asli */}
            <text class="plate__inscription"><textPath href="#plate-inscription" textLength={circleLength(118) - 6} lengthAdjust="spacing">{'HADIIYOK · ASTROLABIUM · JAKARTA · MMXXVI · VI°S · CVI°E · '.repeat(2)}</textPath></text>
            {
              platePoints.map((point, i) => (
                <path
                  class="plate__marker"
                  data-chapter={i}
                  d={`M${point.x} ${point.y - 5} L${point.x + 3} ${point.y} L${point.x} ${point.y + 5} L${point.x - 3} ${point.y} Z`}
                  transform={`rotate(${point.angle} ${point.x} ${point.y})`}
                ></path>
              ))
            }
            {/* alidade: bilah meruncing ke ujung bidik, garis tengah terukir, pemberat berlubang bidik di ekor */}
            <g class="plate__alidade">
              <path class="plate__blade" d="M236.6 140 L243.4 140 L241.3 66 L240 50 L238.7 66 Z"></path>
              <path class="plate__blade" d="M236.6 340 L243.4 340 L242.2 393 L237.8 393 Z"></path>
              <line class="plate__fiducial" x1="240" y1="138" x2="240" y2="58"></line>
              <line class="plate__fiducial" x1="240" y1="342" x2="240" y2="392"></line>
              <circle class="plate__counter" cx="240" cy="403" r="8"></circle>
              <circle class="plate__sight" cx="240" cy="403" r="2.2"></circle>
            </g>
            {/* angka di atas jarum: tepi sewarna latar memotong jarum yang lewat di belakangnya */}
            <g class="plate__rete">{degreeLabels.map((label) => <text class="plate__degree" x={label.x} y={label.y} text-anchor="middle">{label.text}</text>)}</g>
          </svg>
          {/* nama di tepi hanya untuk mouse; pembaca layar dan keyboard memakai daftar di sebelahnya */}
          {
            chapters.map((chapter, i) => (
              <a class="plate__rim" href={`${home}#${chapter.id}`} data-chapter={i} style={`left:${platePoints[i].left}%;top:${platePoints[i].top}%`} aria-hidden="true" tabindex="-1">
                <span>{chapter.roman}</span>
                <strong>{chapter.label}</strong>
              </a>
            ))
          }
          <div class="plate__readout" aria-hidden="true"><span></span><strong></strong><small></small></div>
        </div>
        <div class="ledger">
          <p class="chapter label" aria-hidden="true"><span>{dictionary.nav.index}</span><i></i>I – V</p>
          <ol role="list">
            {
              chapters.map((chapter, i) => (
                <li style={`--i:${i + 1}`}>
                  <a href={`${home}#${chapter.id}`} data-chapter={i} data-number={chapter.number} data-roman={chapter.roman} data-label={chapter.label} data-detail={chapter.detail}>
                    <span>{chapter.roman}</span>
                    <strong>{chapter.label}<em>{chapter.detail}</em></strong>
                    <small>No. {chapter.number}</small>
                  </a>
                </li>
              ))
            }
          </ol>
          <div class="ledger__foot">
            <a class="ledger__cv" href={`/${lang}/cv`} aria-current={path === '/cv' ? 'page' : undefined}>{dictionary.nav.cv} ↗</a>
            <button class="sound ledger__sound" type="button" aria-pressed="false" aria-label={dictionary.sound.play} data-play={dictionary.sound.play} data-pause={dictionary.sound.pause}
              ><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sound__label">{dictionary.sound.label}</span></button
            >
            <span>{dictionary.hero.coordinates}</span>
          </div>
        </div>
      </div>
    </nav>
    <main id="main" tabindex="-1" class:list={{ 'main--padded': !fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="label">© {new Date().getFullYear()} {profile?.full_name} · {dictionary.footer.builtWith}</p>
      </div>
    </footer>
    <script>
      import { startCursor } from '../scripts/cursor';
      import { startNavigation } from '../scripts/navigation';
      import '../scripts/smooth-scroll';
      import { startSky } from '../scripts/sky';
      import { startSound } from '../scripts/sound.js';

      startSky(document.querySelector<HTMLCanvasElement>('.sky')!);
      startCursor();
      startSound();
      startNavigation();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .site-header {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    right: 0;
    left: 0;
    z-index: var(--z-sticky);
  }

  /* selubung gelap muncul setelah halaman digulir, supaya teks konten tidak bertumpuk dengan navbar */
  .site-header::before {
    content: '';
    position: absolute;
    inset: calc(-1 * env(safe-area-inset-top, 0px)) 0 -36px;
    z-index: -1;
    background: linear-gradient(var(--bg) 45%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }

  .site-header.is-scrolled::before {
    opacity: 0.92;
  }

  .site-header__inner {
    --gap: 28px;
    display: flex;
    align-items: center;
    gap: var(--gap);
    min-height: 76px;
  }

  /* garis rambut tegak memisahkan bahasa, suara, dan dial menjadi satu kelompok instrumen */
  .site-header__inner > .sound,
  .dial-button {
    position: relative;
  }

  .site-header__inner > .sound::before,
  .dial-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--gap) / -2);
    width: 1px;
    height: 14px;
    background: var(--line);
    transform: translateY(-50%);
  }

  /* font script hanya dipakai sebagai aksen: logo dan nama di hero */
  .logo {
    padding: 0.1em 0.2em 0.1em 0;
    color: var(--fg);
    font: 400 40px/0.8 var(--font-script);
    text-decoration: none;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--muted);
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .language-switcher a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current='page'] {
    color: var(--fg);
  }

  /* dial: jarumnya maju mengikuti posisi baca, lima tanda di lingkarannya adalah lima bab */
  .dial-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }

  .dial-button__text {
    display: grid;
    justify-items: end;
    gap: 5px;
    color: var(--muted);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color 0.5s var(--ease);
  }

  .dial-button__text small {
    color: var(--gold);
    font: inherit;
  }

  .dial-button__text small:empty {
    display: none;
  }

  .dial-button:hover .dial-button__text,
  .dial-button[aria-expanded='true'] .dial-button__text {
    color: var(--fg);
  }

  .dial {
    width: 42px;
    height: 42px;
    overflow: visible;
  }

  .dial circle {
    fill: none;
  }

  .dial__ring {
    stroke: rgba(217, 194, 154, 0.42);
    stroke-width: 0.8;
    transition: stroke 0.5s var(--ease);
  }

  .dial__inner {
    stroke: rgba(217, 194, 154, 0.14);
    stroke-width: 0.6;
  }

  .dial-button:hover .dial__ring,
  .dial-button[aria-expanded='true'] .dial__ring {
    stroke: var(--gold);
  }

  .dial__tick {
    stroke: var(--faint);
    stroke-width: 1.2;
    transition: stroke 0.6s var(--ease);
  }

  .dial__tick.is-active {
    stroke: var(--sun);
    filter: drop-shadow(0 0 2px rgba(255, 236, 200, 0.9));
  }

  .dial__needle {
    transform-origin: 21px 21px;
    transition: transform 0.8s var(--ease);
  }

  .dial__needle line {
    stroke: var(--sun);
    stroke-width: 0.9;
  }

  .dial__needle path {
    fill: var(--sun);
  }

  .dial .dial__counter {
    stroke: rgba(217, 194, 154, 0.6);
    stroke-width: 0.7;
  }

  .dial .dial__pin {
    fill: var(--bg);
    stroke: var(--gold);
    stroke-width: 0.8;
  }

  /* indeks layar penuh, terbuka melingkar dari dial; di bawah header supaya dial tetap jadi tombol tutup */
  .site-index {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-sticky) - 1);
    display: grid;
    align-items: center;
    padding-block: calc(84px + env(safe-area-inset-top, 0px)) 32px;
    overflow-y: auto;
    background: var(--bg);
    clip-path: circle(0 at var(--ox, 100%) var(--oy, 0));
    visibility: hidden;
    transition: clip-path 1.1s var(--ease), visibility 0s linear 1.1s;
  }

  .site-index.is-open {
    clip-path: circle(150% at var(--ox, 100%) var(--oy, 0));
    visibility: visible;
    transition: clip-path 1.1s var(--ease), visibility 0s;
  }

  .site-index__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: 56px;
  }

  .plate {
    position: relative;
    justify-self: center;
    width: min(100%, 560px, 68vh);
    aspect-ratio: 1;
  }

  /* cahaya hangat samar di belakang pelat, seperti logam yang memantulkan lampu */
  .plate::before {
    content: '';
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(217, 194, 154, 0.045), transparent);
  }

  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .plate__rete {
    transform: rotate(-30deg);
    transform-origin: 240px 240px;
    transition: transform 1.8s var(--ease) 0.1s;
  }

  .site-index.is-open .plate__rete {
    transform: none;
  }

  .plate__degree {
    fill: var(--faint);
    stroke: var(--bg);
    stroke-width: 4px;
    paint-order: stroke;
    font: 400 7px var(--font-mono);
    letter-spacing: 0.08em;
  }

  .plate__window {
    fill: var(--bg);
    stroke: rgba(217, 194, 154, 0.16);
    stroke-width: 0.5;
  }

  .plate__ring {
    fill: none;
    stroke: rgba(217, 194, 154, 0.2);
    stroke-width: 0.6;
  }

  .plate__ring--metal {
    stroke: url(#plate-metal);
    stroke-width: 1.1;
  }

  .plate__ring--hair {
    stroke: rgba(217, 194, 154, 0.12);
    stroke-width: 0.4;
  }

  .plate__scale line {
    stroke: rgba(217, 194, 154, 0.16);
    stroke-width: 0.4;
  }

  .plate__scale .five {
    stroke: rgba(217, 194, 154, 0.26);
    stroke-width: 0.5;
  }

  .plate__scale .mid {
    stroke: rgba(217, 194, 154, 0.36);
    stroke-width: 0.6;
  }

  .plate__scale .major {
    stroke: url(#plate-metal);
    stroke-width: 0.9;
  }

  /* titik-titik halus, satu tiap 5°, seperti guilloché pada pelat jam */
  .plate__dots {
    fill: none;
    stroke: rgba(217, 194, 154, 0.3);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 0 13.09;
    opacity: 0;
    transition: opacity 1.2s var(--ease) 0.6s;
  }

  .plate__inscription {
    fill: var(--faint);
    font: 400 7px var(--font-mono);
    letter-spacing: 0.32em;
    opacity: 0;
    transition: opacity 1.2s var(--ease) 0.8s;
  }

  .site-index.is-open :is(.plate__dots, .plate__inscription) {
    opacity: 1;
  }

  /* garis pelat tergambar sekali saat indeks dibuka */
  .plate__draw {
    stroke-dasharray: var(--length);
    stroke-dashoffset: var(--length);
    transition: stroke-dashoffset 1.6s var(--ease) 0.25s;
  }

  .site-index.is-open .plate__draw {
    stroke-dashoffset: 0;
  }

  .plate__marker {
    fill: var(--faint);
    transition: fill 0.5s var(--ease), filter 0.5s var(--ease);
  }

  .plate__marker.is-current {
    fill: var(--gold);
  }

  .plate__marker.is-aim {
    fill: var(--sun);
    filter: drop-shadow(0 0 3px rgba(255, 236, 200, 0.8));
  }

  .plate__alidade {
    transform-origin: 240px 240px;
    transition: transform 1.1s var(--ease);
    filter: drop-shadow(0 0 5px rgba(255, 236, 200, 0.18));
  }

  .plate__blade {
    fill: url(#alidade-metal);
  }

  .plate__fiducial {
    stroke: rgba(7, 7, 10, 0.55);
    stroke-width: 0.45;
  }

  .plate__counter {
    fill: url(#alidade-metal);
  }

  .plate__sight {
    fill: var(--bg);
    stroke: rgba(7, 7, 10, 0.6);
    stroke-width: 0.5;
  }

  /* bab di tepi pelat, seperti angka jam */
  .plate__rim {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 6px 8px;
    color: var(--muted);
    text-decoration: none;
    transform: translate(-50%, -50%);
    transition: color 0.5s var(--ease);
  }

  .plate__rim span {
    color: var(--faint);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    transition: color 0.5s var(--ease);
  }

  .plate__rim strong {
    color: inherit;
    font: 400 20px/1 var(--font-serif);
    white-space: nowrap;
  }


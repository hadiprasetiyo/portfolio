---
import { Font } from 'astro:assets';
import { getDictionary, LOCALES, type Locale } from '../i18n';
import { getProfile } from '../lib/db';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
  lang: Locale;
  // path tanpa awalan bahasa, dipakai switcher EN · ID dan nav
  path: string;
  // halaman utama menaruh hero di bawah nav yang transparan, halaman lain diberi jarak dari nav
  fullBleed?: boolean;
};

const { title, description, lang, path, fullBleed = false } = Astro.props;
const profile = await getProfile();
const dictionary = getDictionary(lang);

const languageNames: Record<Locale, string> = { en: 'English', id: 'Bahasa Indonesia' };
const home = `/${lang}/`;
// nomor sama dengan nomor bab di halaman utama; About cuma ada di indeks karena letaknya tepat di bawah hero
const chapters = [
  { id: 'about', label: dictionary.nav.about, number: '01', roman: 'I' },
  { id: 'projects', label: dictionary.nav.projects, number: '02', roman: 'II' },
  { id: 'skills', label: dictionary.nav.skills, number: '03', roman: 'III' },
  { id: 'experience', label: dictionary.nav.experience, number: '04', roman: 'IV' },
  { id: 'contact', label: dictionary.nav.contact, number: '05', roman: 'V' },
];
const navigation = chapters.slice(1);
const cvHref = `/${lang}/cv`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07070A" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-script" preload />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <canvas class="sky" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">{dictionary.skipToContent}</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href={home} aria-label={`hadiiyok, ${dictionary.backToTop}`}>hadiiyok</a>
        <nav class="site-nav" aria-label={dictionary.mainNavigation}>
          <ul role="list">
            {
              navigation.map((item) => (
                <li>
                  <a href={`${home}#${item.id}`} data-section={item.id}>
                    <sup>{item.number}</sup>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href={cvHref} aria-current={path === '/cv' ? 'page' : undefined}>{dictionary.nav.cv}</a></li>
          </ul>
          <i class="site-nav__transit" aria-hidden="true"></i>
        </nav>
        <i class="site-header__rule" aria-hidden="true"></i>
        <nav class="language-switcher" aria-label={dictionary.languageSwitcher}>
          {
            LOCALES.map((code, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={`/${code}${path}`}
                  hreflang={code}
                  lang={code}
                  aria-label={languageNames[code]}
                  aria-current={code === lang ? 'page' : undefined}
                >
                  {code.toUpperCase()}
                </a>
              </>
            ))
          }
        </nav>
        <button class="sound" type="button" aria-pressed="false" aria-label={dictionary.sound.play} data-play={dictionary.sound.play} data-pause={dictionary.sound.pause}
          ><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sound__label">{dictionary.sound.label}</span></button
        >
        <button class="index-button" type="button" aria-expanded="false" aria-controls="site-index" data-open={dictionary.nav.index} data-close={dictionary.nav.close}
          ><span class="index-button__label">{dictionary.nav.index}</span
          ><svg class="index-button__dial" viewBox="0 0 30 30" aria-hidden="true"
            ><circle cx="15" cy="15" r="13.5"></circle><circle class="index-button__ticks" cx="15" cy="15" r="9"></circle><line x1="15" y1="15" x2="15" y2="3"></line></svg
          ></button
        >
      </div>
      <div class="meridian" aria-hidden="true"><i></i></div>
    </header>
    <nav class="site-index" id="site-index" aria-label={dictionary.nav.index} inert>
      <div class="wrap site-index__inner">
        <ol class="site-index__list" role="list">
          {
            chapters.map((item) => (
              <li>
                <a href={`${home}#${item.id}`}>
                  <span>{item.roman}</span>
                  <strong>{item.label}</strong>
                  <small>No. {item.number}</small>
                </a>
              </li>
            ))
          }
          <li>
            <a href={cvHref}>
              <span aria-hidden="true"></span>
              <strong>{dictionary.nav.cv}</strong>
            </a>
          </li>
        </ol>
        {/* pelat astrolabe: lingkaran horizon, ekuator, dan tropika, digambar setipis garis rambut */}
        <svg class="site-index__plate" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="48"></circle><circle cx="50" cy="50" r="36"></circle><circle cx="50" cy="58" r="22"></circle><circle cx="50" cy="50" r="12"></circle>
          <line x1="2" y1="50" x2="98" y2="50"></line><line x1="50" y1="2" x2="50" y2="98"></line>
        </svg>
      </div>
    </nav>
    <main id="main" tabindex="-1" class:list={{ 'main--padded': !fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="label">© {new Date().getFullYear()} {profile?.full_name} · {dictionary.footer.builtWith}</p>
      </div>
    </footer>
    <script>
      import { startCursor } from '../scripts/cursor';
      import { startNavigation } from '../scripts/navigation';
      import '../scripts/smooth-scroll';
      import { startSky } from '../scripts/sky';
      import { startSound } from '../scripts/sound.js';

      startSky(document.querySelector<HTMLCanvasElement>('.sky')!);
      startCursor();
      startSound();
      startNavigation();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .site-header {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    right: 0;
    left: 0;
    z-index: var(--z-sticky);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 76px;
  }

  /* font script hanya dipakai sebagai aksen: logo dan nama di hero */
  .logo {
    padding: 0.1em 0.2em 0.1em 0;
    color: var(--fg);
    font: 400 40px/0.8 var(--font-script);
    text-decoration: none;
  }

  .site-nav {
    position: relative;
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: 30px;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-height: 2.75rem;
    padding-top: 14px;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }

  /* nomor bab kecil, sama dengan "No. 02" dan seterusnya di halaman */
  .site-nav sup {
    color: var(--faint);
    font: 400 9px/1 var(--font-mono);
    letter-spacing: 0.1em;
    transition: color 0.5s var(--ease);
  }

  .site-nav a:hover,
  .site-nav a.is-active,
  .site-nav a[aria-current='page'] {
    color: var(--fg);
  }

  .site-nav a.is-active sup {
    color: var(--gold);
  }

  /* bintang transit: melintas ke tautan section yang sedang dibaca, seperti bintang yang melewati meridian */
  .site-nav__transit {
    position: absolute;
    top: 4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--sun);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    filter: drop-shadow(0 0 4px rgba(255, 236, 200, 0.9));
    opacity: 0;
    transition: transform 0.9s var(--ease), opacity 0.6s var(--ease);
    pointer-events: none;
  }

  .site-header__rule {
    width: 1px;
    height: 16px;
    background: var(--line);
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .language-switcher a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current='page'] {
    color: var(--fg);
  }

  /* tombol indeks dengan dial astrolabe yang berputar saat disentuh atau terbuka */
  .index-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .index-button__dial {
    width: 30px;
    height: 30px;
    transition: transform 1.4s var(--ease);
  }

  .index-button:hover .index-button__dial,
  .index-button[aria-expanded='true'] .index-button__dial {
    transform: rotate(120deg);
  }

  .index-button__dial circle {
    fill: none;
    stroke: rgba(217, 194, 154, 0.55);
    stroke-width: 1;
  }

  .index-button__ticks {
    stroke-dasharray: 1 2.6;
  }

  .index-button__dial line {
    stroke: var(--sun);
    stroke-width: 1;
  }

  /* garis meridian selebar layar; ekor emasnya maju mengikuti posisi baca dengan bintang di ujung */
  .meridian {
    position: absolute;
    right: max(24px, env(safe-area-inset-right, 0px));
    bottom: 0;
    left: max(24px, env(safe-area-inset-left, 0px));
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line) 8%, var(--line) 92%, transparent);
    clip-path: inset(-6px 0);
    pointer-events: none;
  }

  .meridian i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(217, 194, 154, 0), rgba(217, 194, 154, 0.85));
    transform: translateX(-100%);
  }

  .meridian i::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -2.5px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 10px 2px rgba(255, 236, 200, 0.55);
  }

  /* indeks bab layar penuh, terbuka melingkar dari dial; di bawah header supaya tombol tutup tetap di tempatnya */
  .site-index {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-sticky) - 1);
    display: grid;
    align-items: center;
    padding-block: calc(76px + env(safe-area-inset-top, 0px)) 40px;
    overflow-y: auto;
    background: var(--bg);
    clip-path: circle(0 at var(--ox, 100%) var(--oy, 0));
    visibility: hidden;
    transition: clip-path 1.1s var(--ease), visibility 0s linear 1.1s;
  }

  .site-index.is-open {
    clip-path: circle(150% at var(--ox, 100%) var(--oy, 0));
    visibility: visible;
    transition: clip-path 1.1s var(--ease), visibility 0s;
  }

  .site-index__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 48px;
  }

  .site-index__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-index__list a {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }

  .site-index__list span,
  .site-index__list small {
    color: var(--faint);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.5s var(--ease);
  }

  .site-index__list strong {
    color: inherit;
    font: 400 clamp(34px, 5.4vw, 72px)/1.02 var(--font-serif);
    letter-spacing: -0.02em;
  }

  .site-index__list a:hover,
  .site-index__list a:focus-visible {
    color: var(--fg);
  }

  .site-index__list a:hover span {
    color: var(--gold);
  }

  .site-index__plate {
    width: min(340px, 28vw);
    aspect-ratio: 1;
    opacity: 0.55;
  }

  .site-index__plate circle,
  .site-index__plate line {
    fill: none;
    stroke: rgba(217, 194, 154, 0.35);
    stroke-width: 0.5;
  }

  /* layar sempit: tautan bab pindah ke indeks; label tombol disembunyikan, dial tetap */
  @media (max-width: 56rem) {
    .site-nav,
    .site-header__rule {
      display: none;
    }

    .language-switcher {
      margin-left: auto;
    }

    .site-index__plate {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      gap: 16px;
    }

    .index-button__label,
    .sound__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .site-index__list a {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .site-index__list small {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-index,
    .site-index.is-open,
    .site-nav__transit,
    .index-button__dial {
      transition: none;
    }
  }

  main {
    position: relative;
  }

  .main--padded {
    padding-block: calc(76px + var(--space-16)) var(--space-24);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    position: relative;
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
</style>
